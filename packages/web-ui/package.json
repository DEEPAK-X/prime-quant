{
	"name": "web-ui",
	"version": "0.7.2",
	"description": "Minimalist split-pane terminal GUI for the PrimeQuant orchestrator: chat stream, sub-agent monitor, tearsheet viewer, and strategy export drawer",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port ${PORT:-5173}",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"demo:backend": "node server/demo-backend.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"ws": "^8.21.0",
		"@tailwindcss/vite": "^4.1.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0"
	}
}
